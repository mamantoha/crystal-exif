<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EXIF Metadata</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <main class="page">
    <header class="page-header">
      <div>
        <h1>EXIF Metadata</h1>
        <p class="subtitle">Metadata extracted from the uploaded image.</p>
      </div>
      <a class="back-link" href="/">Upload another image</a>
    </header>

    <section class="card preview-card" aria-label="Uploaded image preview">
      <img src="data:<%= mime_type %>>;base64,<%= encoded %>" width="500" alt="Uploaded image">
    </section>

    <section class="card">
      <h2>Image details</h2>
      <div class="table-scroll">
        <table>
          <tbody>
            <% data.each do |key, value| %>
              <tr>
                <td><%= key %></td>
                <td><%= value %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>

</html>
