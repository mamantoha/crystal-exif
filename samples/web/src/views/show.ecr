<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EXIF Metadata</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <main class="page">
    <header class="page-header">
      <div>
        <h1>EXIF Metadata</h1>
        <p class="subtitle">Metadata extracted from the uploaded image.</p>
      </div>
      <a class="back-link" href="/">Upload another image</a>
    </header>

    <section class="card preview-card" aria-label="Uploaded image preview">
      <img src="data:<%= mime_type %>;base64,<%= encoded %>" width="500" alt="Uploaded image">
    </section>

    <% if error_message %>
      <section class="card empty-state" role="status">
        <h2>No EXIF metadata found</h2>
        <p><%= error_message %></p>
        <p class="hint">Try another image captured by a camera or phone.</p>
      </section>
    <% else %>
      <section class="card metadata-section">
        <div class="section-heading">
          <h2>EXIF values</h2>
          <span class="count"><%= data.size %> values</span>
        </div>
        <div class="table-scroll">
          <table>
            <tbody>
              <% data.each do |key, value| %>
                <tr>
                  <td><%= HTML.escape(key) %></td>
                  <td><%= HTML.escape(value) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>

      <% unless mnote_data.empty? %>
        <section class="card metadata-section">
          <div class="section-heading">
            <h2>MakerNote values</h2>
            <span class="count"><%= mnote_data.size %> values</span>
          </div>
          <p class="hint">Camera-manufacturer metadata decoded by libexif.</p>
          <div class="table-scroll">
            <table>
              <tbody>
                <% mnote_data.each do |key, value| %>
                  <tr>
                    <td><%= HTML.escape(key) %></td>
                    <td><%= HTML.escape(value) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <section class="card metadata-section">
        <div class="section-heading">
          <h2>Entry details</h2>
          <span class="count"><%= entries.size %> entries</span>
        </div>
        <p class="hint">Byte order: <strong><%= byte_order %></strong>. Raw data is limited to the first <%= RAW_PREVIEW_SIZE %> bytes per entry.</p>
        <div class="table-scroll">
          <table class="entry-table">
            <thead>
              <tr>
                <th scope="col">Tag</th>
                <th scope="col">IFD</th>
                <th scope="col">Format</th>
                <th scope="col">Components</th>
                <th scope="col">Size</th>
                <th scope="col">Value</th>
                <th scope="col">Raw bytes</th>
              </tr>
            </thead>
            <tbody>
              <% entries.each do |entry| %>
                <tr>
                  <td><%= HTML.escape(entry.tag) %> <span class="tag-id">(<%= entry.tag_id %>)</span></td>
                  <td><%= HTML.escape(entry.ifd) %></td>
                  <td><%= HTML.escape(entry.format) %></td>
                  <td><%= entry.components %></td>
                  <td><%= entry.size %> B</td>
                  <td><%= HTML.escape(entry.value) %></td>
                  <td><code><%= entry.raw_bytes %><%= "…" if entry.raw_truncated %></code></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  </main>
</body>

</html>
